  · simp +decide [ funext_iff, Phi ];
    exact fun p hp a ha => by rw [ eval_functional_apply ] ; exact hp a ha;
  · simp +decide;
  · simp +contextual [ LinearMap.mem_ker ];
  · simp +contextual [ LinearMap.mem_ker ]

theorem closure_Y_le_ker_Phi : (Y ι A).topologicalClosure ≤ LinearMap.ker (Phi ι A h_bpe) := by
