open Polynomial Module FiniteDimensional

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (ι : Polynomial ℂ →ₗ[ℂ] H)
variable (hι_dense : (LinearMap.range ι).topologicalClosure = ⊤)
variable (hι_inj : Function.Injective ι)
variable (A : Finset ℂ)
variable (N : ℕ)
variable (hA_card : A.card = N)
variable (h_bpe : ∀ a ∈ A, ∃ (f : H →L[ℂ] ℂ), ∀ p, f (ι p) = p.eval a)

noncomputable def Y : Submodule ℂ H :=
  Submodule.map ι (Submodule.span ℂ {p | ∀ a ∈ A, p.eval a = 0})

noncomputable def eval_functional (a : A) : H →L[ℂ] ℂ :=
  Classical.choose (h_bpe a a.2)

theorem eval_functional_apply (a : A) (p : Polynomial ℂ) :
    eval_functional ι A h_bpe a (ι p) = p.eval (a : ℂ) :=
  Classical.choose_spec (h_bpe a a.2) p

