  ContinuousLinearMap.pi (fun a => eval_functional ι A h_bpe a)

theorem Phi_apply (x : H) (a : A) :
    Phi ι A h_bpe x a = eval_functional ι A h_bpe a x :=
  rfl

theorem Phi_apply_poly (p : Polynomial ℂ) (a : A) :
    Phi ι A h_bpe (ι p) a = p.eval (a : ℂ) := by
  simp [Phi_apply, eval_functional_apply]

/-
Definition of Lagrange basis in H.
Proof that Phi maps Lagrange basis to standard basis vectors.
-/
noncomputable def LagrangeBasis (a : A) : H :=
  ι (Lagrange.basis A id (a : ℂ))

theorem Phi_LagrangeBasis (a b : A) :
    Phi ι A h_bpe (LagrangeBasis ι A a) b = if a = b then 1 else 0 := by
      convert Phi_apply_poly ι A h_bpe ( Lagrange.basis A id a ) b using 1;
      split_ifs with h <;> simp_all +decide [ Lagrange.basis ];
      · simp +decide [ Lagrange.basisDivisor, Polynomial.eval_prod ];
        rw [ Finset.prod_eq_one fun x hx => by rw [ inv_mul_cancel₀ ] ; exact sub_ne_zero_of_ne <| by aesop ];
      · rw [ Polynomial.eval_prod, Finset.prod_eq_zero ( Finset.mem_erase_of_ne_of_mem ( by aesop ) b.2 ) ] ; aesop

/-
The map $\Phi$ is surjective.
-/
theorem Phi_surjective : Function.Surjective (Phi ι A h_bpe) := by
  intro f
  let f' := fun a : A => f a
  have h_sum : ∃ x : H, ∀ a : A, (Phi ι A h_bpe x) a = f' a := by
    -- By definition of Lagrange basis, we have $\Phi(\sum_{a \in A} v(a) \cdot \text{LagrangeBasis}(a)) = \sum_{a \in A} v(a) \cdot \Phi(\text{LagrangeBasis}(a))$.
    have h_sum : ∀ v : A → ℂ, ∃ x : H, ∀ a : A, (Phi ι A h_bpe x) a = v a := by
      intro v
      use ∑ a : A, v a • LagrangeBasis ι A a
      intro a
      simp [Phi_LagrangeBasis]
    generalize_proofs at *;
    exact h_sum f'
  generalize_proofs at *;
  exact ⟨ h_sum.choose, funext h_sum.choose_spec ⟩

