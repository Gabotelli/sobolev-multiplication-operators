    (Y ι A).topologicalClosure = LinearMap.ker (Phi ι A h_bpe) := by
  apply le_antisymm
  · exact closure_Y_le_ker_Phi ι A h_bpe
  · exact ker_Phi_le_closure_Y ι A h_bpe hι_dense