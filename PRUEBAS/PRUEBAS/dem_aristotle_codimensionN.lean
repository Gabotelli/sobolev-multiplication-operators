  · rintro _ ⟨ p, hp, rfl ⟩;
    refine' Submodule.span_induction _ _ _ _ hp;
    · simp +contextual [ funext_iff, Phi_apply ];
      exact fun p hp a ha => by rw [ eval_functional_apply ] ; exact hp a ha;
    · simp +decide;
    · simp +contextual [ map_add ];
    · simp +contextual [ LinearMap.mem_ker ];
  · exact isClosed_eq ( ContinuousLinearMap.continuous _ ) continuous_zero

/-
Y is the intersection of the kernel of Phi and the range of ι.
