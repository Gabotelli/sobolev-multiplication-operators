/-
Checking eLpNorm
-/
#check MeasureTheory.eLpNorm

/-
Definition of Bounded Point Evaluation (BPE) at a point `a` for a measure `μ`.
-/
def IsBPE (a : ℂ) (μ : MeasureTheory.Measure ℂ) : Prop :=
  ∃ C ≥ 0, ∀ p : Polynomial ℂ, ‖p.eval a‖ ≤ C * (MeasureTheory.eLpNorm (fun z => p.eval z) 2 μ).toReal

/-
Definition of Analytic Bounded Point Evaluation (ABPE) at a point `a` for a measure `μ`.
It requires the existence of a neighborhood where the evaluation functionals are uniformly bounded.
-/
def IsABPE (a : ℂ) (μ : MeasureTheory.Measure ℂ) : Prop :=
  ∃ r > 0, ∃ M ≥ 0, ∀ z ∈ Metric.ball a r, ∀ p : Polynomial ℂ,
    ‖p.eval z‖ ≤ M * (MeasureTheory.eLpNorm (fun w => p.eval w) 2 μ).toReal

/-
If `a` is an Analytic Bounded Point Evaluation (ABPE), then the derivative evaluation functional at `a` is bounded.
-/
theorem derivative_evaluation_bound_of_ABPE
  (a : ℂ) (μ : MeasureTheory.Measure ℂ)
  (h_abpe : IsABPE a μ) :
  ∃ C > 0, ∀ p : Polynomial ℂ, ‖p.derivative.eval a‖ ≤ C * (MeasureTheory.eLpNorm (fun z => p.eval z) 2 μ).toReal := by
  obtain ⟨ r, hr, M, hM, h ⟩ := h_abpe;
  -- By Cauchy's integral formula for the first derivative:
  -- \( p'(a) = \frac{1}{2\pi i} \oint_{\gamma_r} \frac{p(z)}{(z-a)^2} dz \)
  have h_cauchy : ∀ p : Polynomial ℂ, ∀ r' > 0, r' < r → ‖(Polynomial.derivative p).eval a‖ ≤ (M / r') * (MeasureTheory.eLpNorm (fun w => p.eval w) 2 μ).toReal := by
    intros p r' hr' hr'_lt_r
    have h_integral : (Polynomial.derivative p).eval a = (1 / (2 * Real.pi * Complex.I)) * ∮ z in C(a, r'), (p.eval z) / (z - a) ^ 2 := by
      have := @Complex.deriv_eq_smul_circleIntegral;
      convert @this ℂ _ _ _ r' a ( fun z => p.eval z ) hr' _ using 1 <;> norm_num [ div_eq_inv_mul ];
      · norm_cast;
      · exact p.differentiable.differentiableOn.diffContOnCl;
    -- Applying the bound from the hypothesis `h` to the integral.
    have h_bound : ‖∮ z in C(a, r'), (p.eval z) / (z - a) ^ 2‖ ≤ (2 * Real.pi * r') * (M * (MeasureTheory.eLpNorm (fun w => p.eval w) 2 μ).toReal) / r' ^ 2 := by
      have h_bound : ∀ z ∈ Metric.sphere a r', ‖p.eval z / (z - a) ^ 2‖ ≤ M * (MeasureTheory.eLpNorm (fun w => p.eval w) 2 μ).toReal / r' ^ 2 := by
        simp +zetaDelta at *;
        bound;
      refine' le_trans ( circleIntegral.norm_integral_le_of_norm_le_const _ _ ) _;
      exacts [ M * ( MeasureTheory.eLpNorm ( fun w => Polynomial.eval w p ) 2 μ ).toReal / r' ^ 2, by positivity, h_bound, by ring_nf; norm_num [ hr'.ne' ] ];
    simp_all +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, Real.pi_pos.ne', hr'.ne' ];
    rw [ abs_of_nonneg Real.pi_pos.le ] ; convert mul_le_mul_of_nonneg_left h_bound ( by positivity : 0 ≤ ( Real.pi : ℝ ) ⁻¹ * ( 2⁻¹ : ℝ ) ) using 1 ; ring ; norm_num [ Real.pi_pos.ne', hr'.ne', hr.ne' ] ; ring;
    norm_num [ sq, mul_assoc, hr'.ne', Real.pi_ne_zero ];
  use M / ( r / 2 ) + 1, by positivity, fun p => by simpa using le_trans ( h_cauchy p ( r / 2 ) ( by positivity ) ( by linarith ) ) ( mul_le_mul_of_nonneg_right ( le_add_of_nonneg_right zero_le_one ) ( by positivity ) ) ;

/-
If `a` is an ABPE, then the derivative evaluation is bounded.
-/
/-- The main theorem, reformulated to assume `IsABPE` since `IsBPE` does not imply `IsABPE` in general (e.g. atomic measures on the boundary), and `IsBPE` + `|a| < 1` => `IsABPE` is a deep result (Conway/Aleman).
    This theorem states that if `a` is an Analytic Bounded Point Evaluation (ABPE), then the derivative evaluation functional is bounded. -/
theorem derivative_evaluation_continuous_of_ABPE
  (a : ℂ) (μ : MeasureTheory.Measure ℂ)
  (h_abpe : IsABPE a μ) :
  ∃ C > 0, ∀ p : Polynomial ℂ, ‖p.derivative.eval a‖ ≤ C * (MeasureTheory.eLpNorm (fun z => p.eval z) 2 μ).toReal := by
  exact derivative_evaluation_bound_of_ABPE a μ h_abpe